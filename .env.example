# Tap Payments — copy these into your Laravel app .env
# Generate keys: Tap Dashboard → goSell → API Credentials → Generate Key
# Docs: https://developers.tap.company/reference/api-endpoint

# Required — Bearer secret (sk_test_* or sk_live_*)
TAP_SECRET_KEY=sk_test_your_secret_key

# Optional — client-side / Card SDK
TAP_PUBLIC_KEY=pk_test_your_public_key

# Optional — auto-attached as merchant.id on create requests when set
TAP_MERCHANT_ID=

# API base (trailing slash optional; SDK normalizes)
TAP_BASE_URL=https://api.tap.company/v2/

# HTTP client
TAP_TIMEOUT=15
TAP_CONNECT_TIMEOUT=5
TAP_RETRY_TIMES=2
TAP_RETRY_SLEEP=200

# Webhooks — set TAP_WEBHOOK_ENABLED=true to register POST /{TAP_WEBHOOK_PATH}
TAP_WEBHOOK_ENABLED=false
TAP_WEBHOOK_PATH=tap/webhook
TAP_WEBHOOK_MIDDLEWARE=api
TAP_WEBHOOK_HASH_HEADER=hashstring
